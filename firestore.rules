rules_version = '2';

// Reglas multi-tenant de Academia Pádel.
//
// Modelo:
//   academias/{tenantId}/...              todos los datos de una academia
//   academias/{tenantId}/miembros/{uid}   usuario + rol dentro de la academia
//
// Roles del modelo: administrador | profesor | alumno_adulto | alumno_menor.
//
// ACCESO POR AHORA: solo `administrador` inicia sesión y opera. Profesor,
// alumno adulto, alumno menor y tutor son FICHAS del modelo, no usuarios con
// acceso: no tienen ninguna concesión de lectura ni escritura. Recepción sigue
// sin definir. El enum de roles se conserva para el futuro.
//
// La única lectura permitida a un no-admin es su propia membresía (arranque de
// sesión y descubrimiento de tenants); con eso la app muestra un aviso y no
// vuelve a leer nada.
//
// Nota de costo: los helpers get()/exists() cuentan como lecturas de Firestore.
// Se mantienen porque son la base de la autorización; si el consumo crece, se
// migra a custom claims en el token (requiere Functions/Admin SDK).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function miembroPath(tenantId) {
      return /databases/$(database)/documents/academias/$(tenantId)/miembros/$(request.auth.uid);
    }

    function esMiembroActivo(tenantId) {
      return signedIn()
        && exists(miembroPath(tenantId))
        && get(miembroPath(tenantId)).data.activo == true;
    }

    function rol(tenantId) {
      return esMiembroActivo(tenantId) ? get(miembroPath(tenantId)).data.rol : '';
    }

    function esAdmin(tenantId) {
      return rol(tenantId) == 'administrador';
    }

    // --- Configuración de sedes y canchas ---------------------------------
    // El horario de una sede es POR DÍA DE LA SEMANA: un mapa con exactamente
    // las claves '0' (lunes) … '6' (domingo) donde cada día es `null` (cerrado)
    // o una franja {apertura, cierre} en MINUTOS múltiplos de 30, dentro de
    // 0-1440 y con cierre > apertura. Ausente = default 07:00-23:00 de la capa
    // de datos. Se sigue aceptando el formato VIEJO (un solo par de horas
    // enteras 0-24) para no denegar la edición de una sede vieja: la capa de
    // datos lo lee expandido a los 7 días y escribe siempre el formato nuevo.
    function franjaValida(franja) {
      return franja == null
        || (franja is map
            && franja.keys().hasOnly(['apertura', 'cierre'])
            && franja.size() == 2
            && franja.apertura is int
            && franja.cierre is int
            && franja.apertura >= 0
            && franja.apertura % 30 == 0
            && franja.cierre <= 1440
            && franja.cierre % 30 == 0
            && franja.cierre > franja.apertura);
    }

    function horarioSemanalValido(horario) {
      return horario.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && horario.size() == 7
        && franjaValida(horario['0'])
        && franjaValida(horario['1'])
        && franjaValida(horario['2'])
        && franjaValida(horario['3'])
        && franjaValida(horario['4'])
        && franjaValida(horario['5'])
        && franjaValida(horario['6']);
    }

    function horarioHeredadoValido(horario) {
      return horario.keys().hasOnly(['apertura', 'cierre'])
        && horario.size() == 2
        && horario.apertura is int
        && horario.cierre is int
        && horario.apertura >= 0
        && horario.apertura <= 24
        && horario.cierre >= 0
        && horario.cierre <= 24
        && horario.cierre > horario.apertura;
    }

    function horarioValido(horario) {
      return horario == null
        || (horario is map
            && (horarioSemanalValido(horario) || horarioHeredadoValido(horario)));
    }

    function horarioDe(data) {
      return data.keys().hasAny(['horario']) ? data.horario : null;
    }

    function tarifasDe(data) {
      return data.keys().hasAny(['tarifas']) ? data.tarifas : null;
    }

    // Nombre de cancha: string no vacío (al menos un carácter que no sea
    // espacio) y con el mismo tope de largo de la capa de datos.
    function nombreCanchaValido(nombre) {
      return nombre is string
        && nombre.size() <= 100
        && nombre.matches('.*[^ ].*');
    }

    function canchaValida(data) {
      return nombreCanchaValido(data.nombre)
        && (!data.keys().hasAny(['activa']) || data.activa is bool);
    }

    // Categoría de grupo de una clase: opcional; si viene, es una de las tres
    // permitidas (o null). Es distinta del nivel `categoria`.
    function categoriaGrupoValida(data) {
      return !data.keys().hasAny(['categoriaGrupo'])
        || data.categoriaGrupo == null
        || data.categoriaGrupo in ['infantil', 'junior', 'adulto'];
    }

    // --- Cobros (Fase 3): perfiles, tarifas por sede y parámetros --------

    // Perfil de cobro: nombre no vacío (mismas reglas que sede/cancha),
    // `modo` del enum, `personas` 1-4 o null, `activo`/`orden` de su tipo si
    // vienen. La unicidad del nombre la garantiza db.js.
    function personasValidas(personas) {
      return personas == null || (personas is int && personas >= 1 && personas <= 4);
    }

    function perfilCobroValido(data) {
      return nombreCanchaValido(data.nombre)
        && data.modo in ['total', 'por_persona']
        && personasValidas(data.personas)
        && (!data.keys().hasAny(['activo']) || data.activo is bool)
        && (!data.keys().hasAny(['orden']) || data.orden is int);
    }

    // Tarifas de una sede: mapa de id de perfil a entero de centavos. Firestore
    // no permite validar cada valor del mapa (no hay iteración con predicado),
    // así que acá solo se exige que sea un mapa de tamaño acotado y se delega
    // el rango de cada monto a db.js (la única capa que escribe). Las claves
    // desconocidas también se validan en db.js contra los perfiles reales.
    function tarifasValidas(tarifas) {
      return tarifas == null || (tarifas is map && tarifas.size() <= 50);
    }

    // Una sede necesita nombre (mismas reglas que una cancha: no vacío y con
    // tope de largo) y, si trae `activa`, tiene que ser booleana: así se cubren
    // crear, renombrar y activar/desactivar. El horario por día y las tarifas
    // se validan aparte.
    function sedeValida(data) {
      return nombreCanchaValido(data.nombre)
        && (!data.keys().hasAny(['activa']) || data.activa is bool)
        && horarioValido(horarioDe(data))
        && tarifasValidas(tarifasDe(data));
    }

    // Parámetros de la academia: cada campo con su tipo/rango. El documento
    // solo puede tener las claves del modelo (más los sellos de auditoría).
    function parametrosValidos(data) {
      return (!data.keys().hasAny(['avisoAusenciaHoras'])
            || (data.avisoAusenciaHoras is int && data.avisoAusenciaHoras >= 0 && data.avisoAusenciaHoras <= 168))
        && (!data.keys().hasAny(['porcentajeFaltaSinAviso'])
            || (data.porcentajeFaltaSinAviso is int && data.porcentajeFaltaSinAviso >= 0 && data.porcentajeFaltaSinAviso <= 100))
        && (!data.keys().hasAny(['pagoProfesor'])
            || (data.pagoProfesor is map
                && data.pagoProfesor.keys().hasOnly(['modo', 'montoCents'])
                && data.pagoProfesor.modo in ['por_hora', 'por_clase']
                && data.pagoProfesor.montoCents is int
                && data.pagoProfesor.montoCents >= 0
                && data.pagoProfesor.montoCents <= 1000000))
        && (!data.keys().hasAny(['descuentoHermanosPct'])
            || (data.descuentoHermanosPct is int && data.descuentoHermanosPct >= 0 && data.descuentoHermanosPct <= 100))
        && (!data.keys().hasAny(['duracionesPermitidas'])
            || (data.duracionesPermitidas is list
                && data.duracionesPermitidas.size() > 0
                && data.duracionesPermitidas.size() <= 8))
        && (!data.keys().hasAny(['vencimientoCreditoDias'])
            || data.vencimientoCreditoDias == null
            || (data.vencimientoCreditoDias is int && data.vencimientoCreditoDias >= 1 && data.vencimientoCreditoDias <= 365))
        && (!data.keys().hasAny(['alertaCobro'])
            || (data.alertaCobro is map
                && data.alertaCobro.keys().hasOnly(['dias', 'referencia'])
                && data.alertaCobro.dias is int
                && data.alertaCobro.dias >= 0
                && data.alertaCobro.dias <= 30
                && data.alertaCobro.referencia in ['clase', 'vencimiento']))
        && (!data.keys().hasAny(['restringirCategoriaPorFranja'])
            || data.restringirCategoriaPorFranja is bool)
        && (!data.keys().hasAny(['repartoAusenciaAvisada'])
            || data.repartoAusenciaAvisada in ['absorbe_academia', 'reparte_entre_presentes'])
        && (!data.keys().hasAny(['pagoProfesorSiTodosFaltanSinAviso'])
            || data.pagoProfesorSiTodosFaltanSinAviso in ['completo', 'proporcional_cobrado', 'nada']);
    }

    // --- Cobros generados al cerrar la clase (Phase 4) -------------------

    // Cargo de un alumno: campos exactos del modelo, enums y centavos enteros
    // >= 0. Los IDs son deterministas (`claseId_alumnoId`), así que un reintento
    // reescribe el mismo documento. No se borran: se anulan.
    function cargoValido(data) {
      return data.keys().hasOnly([
            'claseId',
            'alumnoId',
            'alumnoNombre',
            'sedeId',
            'fecha',
            'concepto',
            'montoCents',
            'estado',
            'pagadoEn',
            'metodoPago',
            'creadoEn'
          ])
        && data.claseId is string
        && data.alumnoId is string
        && data.alumnoNombre is string
        && data.sedeId is string
        && data.fecha is string
        && data.concepto in ['clase', 'falta_sin_aviso', 'mensualidad', 'otro']
        && data.montoCents is int
        && data.montoCents >= 0
        && data.montoCents <= 1000000
        && data.estado in ['pendiente', 'pagado', 'anulado']
        && (!data.keys().hasAny(['pagadoEn']) || data.pagadoEn == null || data.pagadoEn is timestamp)
        && (!data.keys().hasAny(['metodoPago'])
            || data.metodoPago == null
            || data.metodoPago in ['efectivo', 'zelle', 'pago_movil', 'transferencia', 'otro'])
        && (!data.keys().hasAny(['creadoEn']) || data.creadoEn == null || data.creadoEn is timestamp);
    }

    // Pago al profesor por una clase: campos exactos, `base` con modo/minutos.
    function pagoProfesorRegistradoValido(data) {
      return data.keys().hasOnly([
            'claseId',
            'profesorId',
            'profesorNombre',
            'sedeId',
            'fecha',
            'montoCents',
            'base',
            'estado',
            'pagadoEn',
            'metodoPago'
          ])
        && data.claseId is string
        && data.profesorId is string
        && (data.profesorNombre == null || data.profesorNombre is string)
        && data.sedeId is string
        && data.fecha is string
        && data.montoCents is int
        && data.montoCents >= 0
        && data.montoCents <= 1000000
        && data.base is map
        && data.base.keys().hasOnly(['modo', 'minutos'])
        && data.base.modo in ['por_hora', 'por_clase']
        && data.base.minutos is int
        && data.base.minutos >= 0
        && data.estado in ['pendiente', 'pagado', 'anulado']
        && (!data.keys().hasAny(['pagadoEn']) || data.pagadoEn == null || data.pagadoEn is timestamp)
        && (!data.keys().hasAny(['metodoPago'])
            || data.metodoPago == null
            || data.metodoPago in ['efectivo', 'zelle', 'pago_movil', 'transferencia', 'otro']);
    }

    // Snapshot de cobro de una clase: opcional. Si viene, es un mapa con
    // EXACTAMENTE las claves del modelo y con los montos como enteros de
    // centavos >= 0 (los topes y la coherencia fina los valida db.js).
    function cobroValido(cobro) {
      return cobro == null
        || (cobro is map
            && cobro.keys().hasOnly([
                 'perfilCobroId',
                 'modo',
                 'tarifaHoraCents',
                 'montoEstandarCents',
                 'montoCents',
                 'ajustado',
                 'motivoAjuste'
               ])
            && (!cobro.keys().hasAny(['perfilCobroId'])
                || cobro.perfilCobroId == null
                || cobro.perfilCobroId is string)
            && (!cobro.keys().hasAny(['modo']) || cobro.modo == null || cobro.modo in ['total', 'por_persona'])
            && cobro.montoCents is int
            && cobro.montoCents >= 0
            && cobro.montoCents <= 1000000
            && (!cobro.keys().hasAny(['tarifaHoraCents'])
                || cobro.tarifaHoraCents == null
                || (cobro.tarifaHoraCents is int && cobro.tarifaHoraCents >= 0 && cobro.tarifaHoraCents <= 100000))
            && (!cobro.keys().hasAny(['montoEstandarCents'])
                || cobro.montoEstandarCents == null
                || (cobro.montoEstandarCents is int && cobro.montoEstandarCents >= 0 && cobro.montoEstandarCents <= 1000000))
            && (!cobro.keys().hasAny(['ajustado']) || cobro.ajustado is bool)
            && (!cobro.keys().hasAny(['motivoAjuste'])
                || cobro.motivoAjuste == null
                || cobro.motivoAjuste in ['descuento', 'cortesia', 'acuerdo', 'otro']));
    }

    function cobroDe(data) {
      return data.keys().hasAny(['cobro']) ? data.cobro : null;
    }
    match /academias/{tenantId} {
      allow read, write: if esAdmin(tenantId);

      // Un usuario puede leer su propia membresía aunque todavía no figure como
      // activa (necesario para el arranque de sesión y el descubrimiento). Es
      // la única lectura de un no-admin. Listar todas las membresías del tenant
      // es solo para admin.
      match /miembros/{uid} {
        allow get: if esAdmin(tenantId) || request.auth.uid == uid;
        allow list: if esAdmin(tenantId) || resource.data.uid == request.auth.uid;
        allow write: if esAdmin(tenantId);
      }

      match /sedes/{sedeId} {
        allow read: if esAdmin(tenantId);
        // El admin es el único que escribe. Nombre obligatorio (mismas reglas
        // que el de una cancha) y horario por día válido si viene; las sedes sin
        // `horario` siguen permitidas (usan el default 07:00-23:00). Las sedes
        // se desactivan, no se borran, pero el borrado del admin se deja como
        // estaba (igual que en las canchas).
        allow create, update: if esAdmin(tenantId) && sedeValida(request.resource.data);
        allow delete: if esAdmin(tenantId);

        match /canchas/{canchaId} {
          allow read: if esAdmin(tenantId);
          // Nombre no vacío y `activa` booleana; las canchas se desactivan, no
          // se borran, pero el borrado del admin se deja como estaba.
          allow create, update: if esAdmin(tenantId) && canchaValida(request.resource.data);
          allow delete: if esAdmin(tenantId);
        }
      }

      match /profesores/{profesorId} {
        allow read, write: if esAdmin(tenantId);
      }

      // Ficha con datos de contacto: solo admin la lee o la escribe.
      match /alumnos/{alumnoId} {
        allow read, write: if esAdmin(tenantId);
      }

      // La reserva, la reprogramación, la cancelación, la asistencia y el
      // cierre los hace solo el administrador. La categoría de grupo y el
      // SNAPSHOT de cobro, si vienen, tienen que respetar sus enums y sus
      // montos enteros >= 0 (el resto del contenido de la clase lo valida la
      // capa de datos, que es la única que escribe acá).
      match /clases/{claseId} {
        allow read: if esAdmin(tenantId);
        allow create, update: if esAdmin(tenantId)
          && categoriaGrupoValida(request.resource.data)
          && cobroValido(cobroDe(request.resource.data));
        allow delete: if esAdmin(tenantId);
      }

      // Perfiles de cobro: solo admin. Los perfiles NUNCA se borran (soft
      // delete con `activo:false`), así que el delete queda denegado.
      match /perfilesCobro/{perfilId} {
        allow read: if esAdmin(tenantId);
        allow create, update: if esAdmin(tenantId) && perfilCobroValido(request.resource.data);
      }

      // Parámetros de la academia: un único documento `parametros`. Solo admin
      // lo lee/escribe y con los campos del modelo validados. No se borra.
      match /config/parametros {
        allow read: if esAdmin(tenantId);
        allow create, update: if esAdmin(tenantId) && parametrosValidos(request.resource.data);
      }

      // Ocupación de 30 minutos de cancha o de profesor, con ID determinista
      // (§4.1 de docs/modelo-datos.md). El tamaño del bloque (MINUTOS_BLOQUE) y
      // la validación de duración/inicio viven en la capa de datos (db.js), que
      // es la única que escribe estos documentos: acá no se repiten. Solo admin
      // los escribe: los crea y borra la misma transacción que la clase.
      match /bloques/{bloqueId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /planes/{planId} {
        allow read, write: if esAdmin(tenantId);
      }

      // Cargos y pagos al profesor (Phase 4): solo admin, con la forma del
      // modelo validada y SIN borrado (se anulan).
      match /cargos/{cargoId} {
        allow read: if esAdmin(tenantId);
        allow create, update: if esAdmin(tenantId) && cargoValido(request.resource.data);
        allow delete: if false;
      }

      match /pagosProfesor/{pagoId} {
        allow read: if esAdmin(tenantId);
        allow create, update: if esAdmin(tenantId) && pagoProfesorRegistradoValido(request.resource.data);
        allow delete: if false;
      }

      match /pagos/{pagoId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /notasCredito/{notaId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /liquidaciones/{liquidacionId} {
        allow read, write: if esAdmin(tenantId);
      }
    }

    // Descubrimiento de academias del usuario al iniciar sesión:
    // collectionGroup('miembros').where('uid','==',uid). Para las consultas de
    // grupo de colecciones hace falta este match comodín sobre el documento y
    // que el cliente filtre por su propio uid.
    match /{path=**}/miembros/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Todo lo que no esté explícitamente permitido arriba queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
