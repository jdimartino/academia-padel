rules_version = '2';

// Las reglas multi-tenant reales llegan a continuación: validan que el usuario
// pertenezca a academias/{tenantId} y solo permiten acceso a su propia academia.
// Mientras tanto la base queda completamente bloqueada.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
