rules_version = '2';

// Reglas multi-tenant de Academia Pádel.
//
// Modelo:
//   academias/{tenantId}/...              todos los datos de una academia
//   academias/{tenantId}/miembros/{uid}   usuario + rol dentro de la academia
//
// Roles del modelo: administrador | profesor | alumno_adulto | alumno_menor.
//
// ACCESO POR AHORA: solo `administrador` inicia sesión y opera. Profesor,
// alumno adulto, alumno menor y tutor son FICHAS del modelo, no usuarios con
// acceso: no tienen ninguna concesión de lectura ni escritura. Recepción sigue
// sin definir. El enum de roles se conserva para el futuro.
//
// La única lectura permitida a un no-admin es su propia membresía (arranque de
// sesión y descubrimiento de tenants); con eso la app muestra un aviso y no
// vuelve a leer nada.
//
// Nota de costo: los helpers get()/exists() cuentan como lecturas de Firestore.
// Se mantienen porque son la base de la autorización; si el consumo crece, se
// migra a custom claims en el token (requiere Functions/Admin SDK).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function miembroPath(tenantId) {
      return /databases/$(database)/documents/academias/$(tenantId)/miembros/$(request.auth.uid);
    }

    function esMiembroActivo(tenantId) {
      return signedIn()
        && exists(miembroPath(tenantId))
        && get(miembroPath(tenantId)).data.activo == true;
    }

    function rol(tenantId) {
      return esMiembroActivo(tenantId) ? get(miembroPath(tenantId)).data.rol : '';
    }

    function esAdmin(tenantId) {
      return rol(tenantId) == 'administrador';
    }

    match /academias/{tenantId} {
      allow read, write: if esAdmin(tenantId);

      // Un usuario puede leer su propia membresía aunque todavía no figure como
      // activa (necesario para el arranque de sesión y el descubrimiento). Es
      // la única lectura de un no-admin. Listar todas las membresías del tenant
      // es solo para admin.
      match /miembros/{uid} {
        allow get: if esAdmin(tenantId) || request.auth.uid == uid;
        allow list: if esAdmin(tenantId) || resource.data.uid == request.auth.uid;
        allow write: if esAdmin(tenantId);
      }

      match /sedes/{sedeId} {
        allow read, write: if esAdmin(tenantId);

        match /canchas/{canchaId} {
          allow read, write: if esAdmin(tenantId);
        }
      }

      match /profesores/{profesorId} {
        allow read, write: if esAdmin(tenantId);
      }

      // Ficha con datos de contacto: solo admin la lee o la escribe.
      match /alumnos/{alumnoId} {
        allow read, write: if esAdmin(tenantId);
      }

      // La reserva, la reprogramación, la cancelación, la asistencia y el
      // cierre los hace solo el administrador.
      match /clases/{claseId} {
        allow read, write: if esAdmin(tenantId);
      }

      // Ocupación de 30 minutos de cancha o de profesor, con ID determinista
      // (§4.1 de docs/modelo-datos.md). Solo admin los escribe: los crea y
      // borra la misma transacción que la clase.
      match /bloques/{bloqueId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /planes/{planId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /cargos/{cargoId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /pagos/{pagoId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /notasCredito/{notaId} {
        allow read, write: if esAdmin(tenantId);
      }

      match /liquidaciones/{liquidacionId} {
        allow read, write: if esAdmin(tenantId);
      }
    }

    // Descubrimiento de academias del usuario al iniciar sesión:
    // collectionGroup('miembros').where('uid','==',uid). Para las consultas de
    // grupo de colecciones hace falta este match comodín sobre el documento y
    // que el cliente filtre por su propio uid.
    match /{path=**}/miembros/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Todo lo que no esté explícitamente permitido arriba queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
