# Copiar a .env.local y completar. .env.local nunca se commitea.
# VITE_TENANT_ID debe ser exactamente "demo": el build guard rechaza cualquier otro valor.
VITE_TENANT_ID=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=academia-padel-jdm
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fase 0: desarrollo contra el Emulator Suite.
# Producción: poner los valores reales en .env.production.local con VITE_USE_EMULATORS=false
# (el build guard lo exige). El trabajo local usa --mode emulator y .env.emulator.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
