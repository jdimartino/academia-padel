# Modo emulator (vite --mode emulator): desarrollo local y builds contra el Emulator Suite.
# Se commitea: no tiene secretos. Pisa a .env.local en este modo, así que el
# .env.local puede quedar con la config de producción sin afectar el trabajo local.
# La API key y el resto de la config web siguen saliendo de .env.local.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_PROJECT_ID=academia-padel-jdm
VITE_TENANT_ID=demo
