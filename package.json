{
  "name": "academia-padel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "seed": "node scripts/seed.mjs",
    "seed:emu": "firebase emulators:exec --only auth,firestore \"npm run seed\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules.test.js\"",
    "test:db": "firebase emulators:exec --only firestore \"node --test tests/db.test.js\"",
    "test": "npm run test:rules && npm run test:db"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
