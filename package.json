{
  "name": "academia-padel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@academia/site-demo",
    "build": "npm run build:emulator --workspace=@academia/site-demo",
    "build:prod": "npm run build --workspace=@academia/site-demo",
    "lint": "oxlint",
    "preview": "npm run preview --workspace=@academia/site-demo",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "local": "node scripts/local.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:emu": "firebase emulators:exec --only auth,firestore \"npm run seed\"",
    "test:rules": "firebase emulators:exec --only firestore \"node --test packages/academia-core/tests/rules.test.js\"",
    "test:db": "firebase emulators:exec --only firestore \"node --test packages/academia-core/tests/db.test.js\"",
    "test:lib": "node --test packages/academia-core/tests/lib.test.js packages/academia-core/tests/avisos.test.js packages/academia-core/tests/accion.test.js packages/academia-core/tests/seed.test.js",
    "test": "npm run test:lib && npm run test:rules && npm run test:db"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
